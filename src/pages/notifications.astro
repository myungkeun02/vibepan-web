---
import type { PageData } from '../contracts/notifications';
import EmptyState from '../components/EmptyState.astro';
import Base from '../layouts/Base.astro';
const { items } = Astro.locals.presentation.data as PageData;
---

<Base title="내 알림" noindex
  ><section class="narrow" style="margin:auto">
    <header class="page-head">
      <div class="flex between">
        <h1>새로운 소식</h1><form data-api method="post" action="/api/notifications/read">
          <input name="csrf" type="hidden" value={Astro.locals.csrf} /><button
            class="button secondary small"
            type="submit">모두 읽음</button
          >
        </form>
      </div>
    </header>{
      items.map((n) => (
        <article class="post-preview">
          <a href={'/community/' + n.post_id + (n.comment_id ? '#comment-' + n.comment_id : '')}>
            <>
              <span class="small accent">{n.is_read ? '읽음' : '● 새 알림'}</span>
              <h3>{n.label}</h3>
              <p>{n.title}</p>
            </>
          </a>
          {!n.is_read && (
            <form data-api method="post" action="/api/notifications/read">
              <input name="csrf" type="hidden" value={Astro.locals.csrf} />
              <input name="id" type="hidden" value={n.id} />
              <button class="text-button" type="submit">
                읽음 표시
              </button>
            </form>
          )}
        </article>
      ))
    }{
      !items.length && (
        <EmptyState>
          <>
            <h3>새로운 알림이 없어요.</h3>
            <p>댓글과 답글이 달리면 여기에서 알려드릴게요.</p>
            <a href="/community" class="button secondary">
              이야기 둘러보기
            </a>
          </>
        </EmptyState>
      )
    }
  </section></Base
>
