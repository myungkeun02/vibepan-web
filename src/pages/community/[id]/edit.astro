---
import type { PageData } from '../../../contracts/community/[id]/edit';
import Base from '../../../layouts/Base.astro';
import PostEditor from '../../../components/PostEditor.astro';
const { p, allowed } = Astro.locals.presentation.data as PageData;
---

<Base
  title="이야기 수정"
  pageKind="editor"
  mobileTitle="이야기 수정"
  mobileBack={'/community/' + Astro.params.id}
  noindex
  ><header class="page-head"><h1>{allowed ? '이야기 수정' : '이 글을 수정할 수 없어요.'}</h1></header>{
    allowed && <PostEditor post={p} />
  }</Base
>
