{
  "name": "vibepan-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs --dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "icons:fetch": "node scripts/fetch-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "marked": "^17.0.0",
    "pretendard": "^1.3.9",
    "sanitize-html": "^2.17.0",
    "zod": "^4.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/sanitize-html": "^2.16.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "icojs": "1.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "license": "MIT"
}
